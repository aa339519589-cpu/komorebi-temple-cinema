+}
+const RINGS=[
+ {n:24,phase:.08,base:.018,span:.620,width:.110,root:.615,curve1:.950,curve2:.930,tip:.905,lean:.048},
+ {n:22,phase:.57,base:.258,span:.688,width:.122,root:.638,curve1:.830,curve2:.820,tip:.740,lean:-.034},
