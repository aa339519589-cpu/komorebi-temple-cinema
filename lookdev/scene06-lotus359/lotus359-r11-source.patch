+ b.root.userData.sourceLotus359??=[];b.root.userData.sourceLotus359.push({revision:'r11',rows:3,petals:70,radius,height,depthAspect,sourceContactSha256:sourceBearing.sourceBufferSha256,actualHemContourAndCoreRetained:true,sourceSculptureEdited:false,scope:'Main lotus only; side seats remain258',construction:'Individually closed cast lobes with smooth cubic convex meridians, rounded transverse bellies, tapered solid thickness, longer narrow rounded points and alternating oblique lean; three leaf proportions, shorter radius-contained outer leaves exposing the upper row, and inward-recessed staggered tiers, with restrained ribs and paired chisel channels. Roots enter retained lower foot or continuous load-bearing core; last tier follows actual hem. Authored inference from supplied reference, not a seat scan.',visualAccepted:false,photographicAccepted:false});
